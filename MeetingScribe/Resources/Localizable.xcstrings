    "Stored in Keychain" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Uloženo v Klíčence" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Uložené v Kľúčenke" } } } },
    "System" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Systém" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Systém" } } } },
