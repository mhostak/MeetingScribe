    "Markdown and exported files will be stored in" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Markdown a exportované soubory budou uloženy v" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Markdown a exportované súbory sa uložia v" } } } },
