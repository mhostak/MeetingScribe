    "Controls the app interface, status messages, errors, notifications, and permission guidance." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Ovládá jazyk rozhraní, stavových zpráv, chyb, oznámení a pokynů k oprávněním." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Ovláda jazyk rozhrania, stavových správ, chýb, oznámení a pokynov k povoleniam." } } } },
    "Controls the language of the Markdown summary and action items. It does not change transcription." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Ovládá jazyk Markdown shrnutí a úkolů. Nemění jazyk přepisu." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Ovláda jazyk Markdown súhrnu a úloh. Nemení jazyk prepisu." } } } },
