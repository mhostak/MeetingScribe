    "Shows a macOS notification when transcription finishes or stops. Notifications require permission in System Settings." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zobrazí oznámení macOS po dokončení nebo zastavení přepisu. Oznámení vyžadují povolení v Nastavení systému." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zobrazí oznámenie macOS po dokončení alebo zastavení prepisu. Oznámenia vyžadujú povolenie v Nastaveniach systému." } } } },
