    "Make sure you have the required permission or participant consent." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Ujistěte se, že máte potřebné oprávnění nebo souhlas účastníků." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Uistite sa, že máte potrebné oprávnenie alebo súhlas účastníkov." } } } },
