    "MeetingScribe ready" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe je připraven" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe je pripravený" } } } },
