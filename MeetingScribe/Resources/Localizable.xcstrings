    "Say a short sentence. If testing system audio, play sound during the test." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Řekněte krátkou větu. Pokud testujete systémový zvuk, přehrajte během testu zvuk." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Povedzte krátku vetu. Ak testujete systémový zvuk, prehrajte počas testu zvuk." } } } },
    "The setup test is unavailable while MeetingScribe is busy." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Test přípravy není dostupný, když je MeetingScribe zaneprázdněný." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Test prípravy nie je dostupný, keď je MeetingScribe zaneprázdnený." } } } },
