    "Nothing is deleted when a recovery is closed." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Při zavření obnovy se nic nesmaže." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Pri zavretí obnovy sa nič neodstráni." } } } },
    "Original audio is preserved until processing completes." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Původní zvuk je zachován až do dokončení zpracování." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Pôvodný zvuk je zachovaný až do dokončenia spracovania." } } } },
    "Preserved artifact: transcript" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zachovaný artefakt: přepis" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zachovaný artefakt: prepis" } } } },
    "Preserved session files" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zachované soubory setkání" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zachované súbory stretnutia" } } } },
    "Preserved track: microphone" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zachovaná stopa: mikrofon" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zachovaná stopa: mikrofón" } } } },
    "Preserved track: system audio" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zachovaná stopa: systémový zvuk" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zachovaná stopa: systémový zvuk" } } } },
    "Preserved tracks: system audio and microphone" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zachované stopy: systémový zvuk a mikrofon" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zachované stopy: systémový zvuk a mikrofón" } } } },
    "Processing did not produce a completed Markdown output." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zpracování nevytvořilo dokončený výstup Markdown." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Spracovanie nevytvorilo dokončený výstup Markdown." } } } },
    "Recording audio activity" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Aktivita nahrávaného zvuku" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Aktivita nahrávaného zvuku" } } } },
    "Recording continues if this popover is closed." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Nahrávání pokračuje i po zavření tohoto okna." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Nahrávanie pokračuje aj po zavretí tohto okna." } } } },
    "Recording session folder (default)" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Složka nahrávky setkání (výchozí)" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Priečinok nahrávky stretnutia (predvolený)" } } } },
    "Recording was interrupted before it could be finalized." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Nahrávání bylo přerušeno před dokončením." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Nahrávanie bolo prerušené pred dokončením." } } } },
    "Session settings are locked while recording or processing." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Nastavení setkání jsou během nahrávání nebo zpracování uzamčena." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Nastavenia stretnutia sú počas nahrávania alebo spracovania uzamknuté." } } } },
    "Start new meeting" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Spustit nové setkání" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Spustiť nové stretnutie" } } } },
    "System audio" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Systémový zvuk" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Systémový zvuk" } } } },
    "The previous processing attempt failed." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Předchozí pokus o zpracování selhal." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Predchádzajúci pokus o spracovanie zlyhal." } } } },
    "MeetingScribe does not have Microphone permission. Enable it in System Settings → Privacy & Security → Microphone, then quit and reopen MeetingScribe. System audio recording can continue." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe nemá oprávnění k mikrofonu. Povolte je v Nastavení systému → Soukromí a zabezpečení → Mikrofon, potom MeetingScribe ukončete a znovu spusťte. Nahrávání systémového zvuku může pokračovat." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe nemá povolenie k mikrofónu. Povoľte ho v Systémových nastaveniach → Súkromie a bezpečnosť → Mikrofón, potom MeetingScribe ukončite a znova spustite. Nahrávanie systémového zvuku môže pokračovať." } } } },
    "MeetingScribe does not have Screen Recording permission. Enable it in System Settings → Privacy & Security → Screen & System Audio Recording, then quit and reopen MeetingScribe." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe nemá oprávnění k nahrávání obrazovky. Povolte je v Nastavení systému → Soukromí a zabezpečení → Nahrávání obrazovky a systémového zvuku, potom MeetingScribe ukončete a znovu spusťte." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe nemá povolenie na nahrávanie obrazovky. Povoľte ho v Systémových nastaveniach → Súkromie a bezpečnosť → Nahrávanie obrazovky a systémového zvuku, potom MeetingScribe ukončite a znova spustite." } } } },
    "No usable microphone input is available. System audio recording can continue." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Není k dispozici použitelný mikrofonní vstup. Nahrávání systémového zvuku může pokračovat." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Nie je dostupný použiteľný mikrofónový vstup. Nahrávanie systémového zvuku môže pokračovať." } } } },
    "active" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "aktivní" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "aktívny" } } } },
    "capture error" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "chyba záznamu" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "chyba nahrávania" } } } },
    "no recent data" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "žádná nová data" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "žiadne nové dáta" } } } },
    "segments" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "segmentů" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "segmentov" } } } },
    "waiting for data" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "čekání na data" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "čakanie na dáta" } } } },
    "Continuous utterances" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Souvislé promluvy" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Súvislé prehovory" } } } },
    "%lld confirmed participants" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "%lld potvrzených účastníků" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "%lld potvrdených účastníkov" } } } },
    "%lld invitees" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "%lld pozvaných" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "%lld pozvaných" } } } },
    "AI analysis is off. Participant names will remain local." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "AI analýza je vypnutá. Jména účastníků zůstanou místní." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "AI analýza je vypnutá. Mená účastníkov zostanú lokálne." } } } },
    "All day" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Celý den" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Celý deň" } } } },
    "Allow full Calendar access in System Settings to choose an event. Write-only access cannot read existing events." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Pro výběr události povolte v Nastavení systému plný přístup ke Kalendáři. Přístup pouze pro zápis nedokáže číst existující události." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Ak chcete vybrať udalosť, povoľte v Systémových nastaveniach úplný prístup ku Kalendáru. Prístup iba na zápis nedokáže čítať existujúce udalosti." } } } },
    "Allowed" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Povoleno" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Povolené" } } } },
    "Apple Calendar" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Kalendář Apple" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Kalendár Apple" } } } },
    "Calendar" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Kalendář" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Kalendár" } } } },
    "Calendar events are unavailable" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Události Kalendáře nejsou dostupné" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Udalosti Kalendára nie sú dostupné" } } } },
    "Calendar integration is off" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Integrace Kalendáře je vypnutá" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Integrácia Kalendára je vypnutá" } } } },
    "Calendar permission is required" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Je potřeba oprávnění ke Kalendáři" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Vyžaduje sa povolenie ku Kalendáru" } } } },
    "Calendar setup is required" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Je potřeba nastavit Kalendář" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Je potrebné nastaviť Kalendár" } } } },
    "Calendar access is configured in MeetingScribe Settings. Event and participant selection remains specific to this meeting." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Přístup ke Kalendáři se nastavuje v Nastavení MeetingScribe. Výběr události a účastníků zůstává samostatný pro toto setkání." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Prístup ku Kalendáru sa nastavuje v Nastaveniach MeetingScribe. Výber udalosti a účastníkov zostáva samostatný pre toto stretnutie." } } } },
    "Change" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Změnit" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zmeniť" } } } },
    "Choose an event" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Vyberte událost" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Vyberte udalosť" } } } },
    "Choose from Calendar" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Vybrat z Kalendáře" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Vybrať z Kalendára" } } } },
    "Confirm event" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Potvrdit událost" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Potvrdiť udalosť" } } } },
    "Denied" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zamítnuto" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zamietnuté" } } } },
    "Enable Apple Calendar integration" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zapnout integraci Kalendáře Apple" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zapnúť integráciu Kalendára Apple" } } } },
    "Full access is used only to offer nearby event titles, times, invitee names, and editable event descriptions. Email addresses, locations, links, calendar names, and Apple event identifiers are not saved." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Plný přístup se používá jen k nabídnutí názvů a časů blízkých událostí, jmen pozvaných a upravitelných popisů událostí. E-mailové adresy, místa, odkazy, názvy kalendářů ani identifikátory událostí Apple se neukládají." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Úplný prístup sa používa iba na ponúknutie názvov a časov blízkych udalostí, mien pozvaných a upraviteľných popisov udalostí. E-mailové adresy, miesta, odkazy, názvy kalendárov ani identifikátory udalostí Apple sa neukladajú." } } } },
    "Full access is needed to read event titles, times, and invitee display names. MeetingScribe does not store email addresses, locations, notes, meeting links, calendar names, or Apple event identifiers." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Plný přístup je potřeba ke čtení názvů a časů událostí a zobrazovaných jmen pozvaných. MeetingScribe neukládá e-mailové adresy, místa, poznámky, odkazy na schůzky, názvy kalendářů ani identifikátory událostí Apple." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Úplný prístup je potrebný na čítanie názvov a časov udalostí a zobrazovaných mien pozvaných. MeetingScribe neukladá e-mailové adresy, miesta, poznámky, odkazy na stretnutia, názvy kalendárov ani identifikátory udalostí Apple." } } } },
    "Full access is used only to offer nearby event titles, times, and invitee display names. Email addresses, locations, notes, links, calendar names, and Apple event identifiers are not saved." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Plný přístup se používá jen k nabídnutí názvů a časů blízkých událostí a zobrazovaných jmen pozvaných. E-mailové adresy, místa, poznámky, odkazy, názvy kalendářů ani identifikátory událostí Apple se neukládají." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Úplný prístup sa používa iba na ponúknutie názvov a časov blízkych udalostí a zobrazovaných mien pozvaných. E-mailové adresy, miesta, poznámky, odkazy, názvy kalendárov ani identifikátory udalostí Apple sa neukladajú." } } } },
    "MeetingScribe can read calendar events." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe může číst události kalendáře." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe môže čítať udalosti kalendára." } } } },
    "MeetingScribe never reads Calendar until you enable this integration. Each event and participant selection must also be confirmed for the individual meeting." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe Kalendář nečte, dokud tuto integraci nezapnete. Výběr události a účastníků je navíc nutné potvrdit pro každé jednotlivé setkání." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe nečíta Kalendár, kým túto integráciu nezapnete. Výber udalosti a účastníkov je navyše potrebné potvrdiť pre každé jednotlivé stretnutie." } } } },
    "MeetingScribe reads events only after you enable the integration and grant macOS permission. Every event and participant selection still requires confirmation for this meeting." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe čte události až po zapnutí integrace a udělení oprávnění v macOS. Každý výběr události a účastníků je stále nutné potvrdit pro toto setkání." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe číta udalosti až po zapnutí integrácie a udelení povolenia v macOS. Každý výber udalosti a účastníkov je stále potrebné potvrdiť pre toto stretnutie." } } } },
    "No events were found for the current recording time. You can keep the manually entered meeting title." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Pro aktuální čas nahrávání nebyly nalezeny žádné události. Ručně zadaný název setkání můžete ponechat." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Pre aktuálny čas nahrávania sa nenašli žiadne udalosti. Ručne zadaný názov stretnutia môžete ponechať." } } } },
    "No nearby events" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Žádné blízké události" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Žiadne blízke udalosti" } } } },
    "Not requested" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Nevyžádáno" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Nevyžiadané" } } } },
    "Only the confirmed snapshot is saved with the recording." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "S nahrávkou se uloží pouze potvrzený snímek údajů." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "S nahrávkou sa uloží iba potvrdená snímka údajov." } } } },
    "Include event description" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zahrnout popis události" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zahrnúť popis udalosti" } } } },
    "Open System Settings" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Otevřít Nastavení systému" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Otvoriť Systémové nastavenia" } } } },
    "Open Calendar Settings" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Otevřít nastavení Kalendáře" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Otvoriť nastavenia Kalendára" } } } },
    "People who actually attended" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Lidé, kteří se skutečně zúčastnili" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Ľudia, ktorí sa skutočne zúčastnili" } } } },
    "Selected participant names are included in meeting metadata and AI analysis." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Vybraná jména účastníků se zahrnou do metadat setkání a AI analýzy." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Vybrané mená účastníkov sa zahrnú do metadát stretnutia a AI analýzy." } } } },
    "Permission" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Oprávnění" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Povolenie" } } } },
    "Permission status" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Stav oprávnění" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Stav povolenia" } } } },
    "Remove calendar selection" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Odebrat výběr z kalendáře" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Odstrániť výber z kalendára" } } } },
    "Request Calendar access" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Požádat o přístup ke Kalendáři" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Požiadať o prístup ku Kalendáru" } } } },
    "Restricted" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Omezeno" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Obmedzené" } } } },
    "Saved meetings" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Uložená setkání" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Uložené stretnutia" } } } },
    "This event has no invitees with a display name. You can still confirm the event." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tato událost nemá pozvané se zobrazovaným jménem. Událost můžete přesto potvrdit." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Táto udalosť nemá pozvaných so zobrazovaným menom. Udalosť môžete napriek tomu potvrdiť." } } } },
    "This event has no description. Enable the option to add one." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tato událost nemá popis. Zapnutím volby jej můžete přidat." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Táto udalosť nemá popis. Zapnutím voľby ho môžete pridať." } } } },
    "Turning this integration off stops future Calendar reads. Confirmed snapshots already stored with recordings are preserved so their Markdown output remains reproducible." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Vypnutí této integrace zastaví budoucí čtení Kalendáře. Potvrzené snímky údajů již uložené s nahrávkami zůstanou zachované, aby jejich výstup Markdown zůstal opakovatelný." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Vypnutie tejto integrácie zastaví budúce čítanie Kalendára. Potvrdené snímky údajov už uložené s nahrávkami zostanú zachované, aby ich výstup Markdown zostal opakovateľný." } } } },
    "Use the event title for this meeting" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Použít název události pro toto setkání" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Použiť názov udalosti pre toto stretnutie" } } } },
    "Write-only access" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Přístup pouze pro zápis" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Prístup iba na zápis" } } } },
    "Combined download size" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Celková velikost ke stažení" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Celková veľkosť na stiahnutie" } } } },
    "Controls the language expected in the recorded audio. Auto is best for mixed-language meetings." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Určuje očekávaný jazyk nahraného zvuku. Automatická volba je nejlepší pro vícejazyčná setkání." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Určuje očakávaný jazyk nahraného zvuku. Automatická voľba je najlepšia pre viacjazyčné stretnutia." } } } },
    "Delete invalid model" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Smazat neplatný model" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Odstrániť neplatný model" } } } },
    "Legacy model files from older versions are not used and are never removed automatically." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Staré soubory modelů z předchozích verzí se nepoužívají a nikdy se neodstraňují automaticky." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Staré súbory modelov z predchádzajúcich verzií sa nepoužívajú a nikdy sa neodstraňujú automaticky." } } } },
    "Finalized audio and inference stay on this Mac. Network access is used only for an explicit model installation or repair." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Dokončený zvuk i zpracování zůstávají na tomto Macu. Síť se používá pouze při výslovně spuštěné instalaci nebo opravě modelu." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Dokončený zvuk aj spracovanie zostávajú na tomto Macu. Sieť sa používa iba pri výslovne spustenej inštalácii alebo oprave modelu." } } } },
    "FluidAudio" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "FluidAudio" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "FluidAudio" } } } },
    "Import verified folder…" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Importovat ověřenou složku…" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Importovať overený priečinok…" } } } },
    "Installing" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Instalace" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Inštalácia" } } } },
    "MeetingScribe uses pinned FluidAudio model bundles for local transcription and speaker diarization. Models are downloaded only when you request them and are verified before installation." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe používá připnuté balíčky modelů FluidAudio pro místní přepis a diarizaci mluvčích. Modely se stahují jen na vyžádání a před instalací se ověří." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe používa pripnuté balíky modelov FluidAudio na lokálny prepis a diarizáciu rečníkov. Modely sa sťahujú iba na vyžiadanie a pred inštaláciou sa overia." } } } },
    "Model source" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zdroj modelu" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zdroj modelu" } } } },
    "Repair" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Opravit" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Opraviť" } } } },
    "Speaker diarization model" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Model diarizace mluvčích" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Model diarizácie rečníkov" } } } },
    "Storage and attribution" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Úložiště a uvedení zdroje" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Úložisko a uvedenie zdroja" } } } },
    "Transcription model" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Model přepisu" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Model prepisu" } } } },
    "Verify and repair" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Ověřit a opravit" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Overiť a opraviť" } } } },
    "You can close this popover. Processing will continue." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Toto okno můžete zavřít. Zpracování bude pokračovat." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Toto okno môžete zavrieť. Spracovanie bude pokračovať." } } } },
    "%lld turns" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "%lld promluv" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "%lld prehovorov" } } } },
    "%lld turns · %lld s" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "%lld promluv · %lld s" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "%lld prehovorov · %lld s" } } } },
    "Anonymous" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Anonymní" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Anonymný" } } } },
    "Display name" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zobrazované jméno" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zobrazované meno" } } } },
    "Edit speakers" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Upravit mluvčí" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Upraviť rečníkov" } } } },
    "Loading speakers…" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Načítání mluvčích…" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Načítavanie rečníkov…" } } } },
    "Merge" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Sloučit" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zlúčiť" } } } },
    "Merged into %@" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Sloučeno do %@" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zlúčené do %@" } } } },
    "Named" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Pojmenovaný" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Pomenovaný" } } } },
    "Rename or merge anonymous speaker clusters. Raw transcripts and audio are never changed." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Přejmenujte nebo slučte anonymní skupiny mluvčích. Zdrojové přepisy ani zvuk se nikdy nezmění." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Premenujte alebo zlúčte anonymné skupiny rečníkov. Zdrojové prepisy ani zvuk sa nikdy nezmenia." } } } },
    "Save speaker changes" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Uložit změny mluvčích" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Uložiť zmeny rečníkov" } } } },
    "Speakers" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Mluvčí" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Rečníci" } } } },
    "Speakers unavailable" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Mluvčí nejsou dostupní" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Rečníci nie sú dostupní" } } } },
    "Undo merge" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zrušit sloučení" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zrušiť zlúčenie" } } } },
    "Allow audio cleanup" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Povolit čištění zvuku" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Povoliť čistenie zvuku" } } } },
    "Allow automatic audio cleanup" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Povolit automatické čištění zvuku" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Povoliť automatické čistenie zvuku" } } } },
    "Audio kept" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zvuk zachován" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zvuk zachovaný" } } } },
    "Audio removed" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zvuk odstraněn" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zvuk odstránený" } } } },
    "Automatic deletion applies only after successful transcription and Markdown export. Use Keep audio on an individual recording to exempt it." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Automatické mazání se použije až po úspěšném přepisu a exportu Markdownu. Jednotlivou nahrávku můžete vyjmout volbou Zachovat zvuk." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Automatické odstraňovanie sa použije až po úspešnom prepise a exporte Markdownu. Jednotlivú nahrávku môžete vyňať voľbou Zachovať zvuk." } } } },
    "Can be removed now" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Lze odstranit nyní" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Možno odstrániť teraz" } } } },
    "Delete after 7 days" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Smazat po 7 dnech" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Odstrániť po 7 dňoch" } } } },
    "Delete after 30 days" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Smazat po 30 dnech" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Odstrániť po 30 dňoch" } } } },
    "Delete after successful processing" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Smazat po úspěšném zpracování" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Odstrániť po úspešnom spracovaní" } } } },
    "Done" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Hotovo" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Hotovo" } } } },
    "Eligible recordings" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Vhodné nahrávky" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Vhodné nahrávky" } } } },
    "Enable automatic audio deletion" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zapnout automatické mazání zvuku" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zapnúť automatické odstraňovanie zvuku" } } } },
    "Enable automatic recording audio deletion?" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zapnout automatické mazání zvuku nahrávek?" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zapnúť automatické odstraňovanie zvuku nahrávok?" } } } },
    "Keep audio" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zachovat zvuk" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zachovať zvuk" } } } },
    "Keep forever" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zachovat navždy" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zachovať navždy" } } } },
    "Last cleanup freed %@ from %lld recordings." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Poslední čištění uvolnilo %@ z %lld nahrávek." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Posledné čistenie uvoľnilo %@ z %lld nahrávok." } } } },
    "Manage storage" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Spravovat úložiště" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Spravovať úložisko" } } } },
    "Permanently remove processed recording audio?" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Trvale odstranit zvuk zpracovaných nahrávek?" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Natrvalo odstrániť zvuk spracovaných nahrávok?" } } } },
    "Protected recordings" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Chráněné nahrávky" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Chránené nahrávky" } } } },
    "Recording audio retention" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Uchování zvuku nahrávek" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Uchovávanie zvuku nahrávok" } } } },
    "Recording storage" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Úložiště nahrávek" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Úložisko nahrávok" } } } },
    "Remove audio permanently" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Trvale odstranit zvuk" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Natrvalo odstrániť zvuk" } } } },
    "Remove processed audio…" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Odstranit zpracovaný zvuk…" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Odstrániť spracovaný zvuk…" } } } },
    "Removed to save space" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Odstraněno pro úsporu místa" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Odstránené na uvoľnenie miesta" } } } },
    "Rescan" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Znovu zkontrolovat" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Znova skontrolovať" } } } },
    "Scanning recordings…" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Kontrola nahrávek…" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Kontrola nahrávok…" } } } },
    "Stored recording audio" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Uložený zvuk nahrávek" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Uložený zvuk nahrávok" } } } },
    "This will permanently remove %@ from %lld processed recordings. This cannot be undone." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tím trvale odstraníte %@ z %lld zpracovaných nahrávek. Tuto akci nelze vrátit zpět." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Týmto natrvalo odstránite %@ z %lld spracovaných nahrávok. Túto akciu nemožno vrátiť späť." } } } },
    "Transcript and Markdown remain available. Repeat transcription and speaker editing will no longer be possible for cleaned recordings." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Přepis a Markdown zůstanou dostupné. U vyčištěných nahrávek už nebude možné přepis zopakovat ani upravovat mluvčí." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Prepis a Markdown zostanú dostupné. Pri vyčistených nahrávkach už nebude možné zopakovať prepis ani upravovať rečníkov." } } } },
    "Transcript and Markdown will stay available, but repeat transcription and speaker editing require the original audio. Failed, incomplete, and protected recordings are never deleted." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Přepis a Markdown zůstanou dostupné, ale opakovaný přepis a úprava mluvčích vyžadují původní zvuk. Zvuk neúspěšných, nedokončených a chráněných nahrávek se nikdy nemaže." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Prepis a Markdown zostanú dostupné, ale opakovaný prepis a úprava rečníkov vyžadujú pôvodný zvuk. Zvuk neúspešných, nedokončených a chránených nahrávok sa nikdy neodstraňuje." } } } },
    "Pausing processing" : {"localizations" : {"cs" : {"stringUnit" : {"state" : "translated", "value" : "Pozastavuji zpracování"}}, "sk" : {"stringUnit" : {"state" : "translated", "value" : "Pozastavujem spracovanie"}}}},
    "Processing" : {"localizations" : {"cs" : {"stringUnit" : {"state" : "translated", "value" : "Zpracování"}}, "sk" : {"stringUnit" : {"state" : "translated", "value" : "Spracovanie"}}}},
    "Processing paused" : {"localizations" : {"cs" : {"stringUnit" : {"state" : "translated", "value" : "Zpracování pozastaveno"}}, "sk" : {"stringUnit" : {"state" : "translated", "value" : "Spracovanie pozastavené"}}}},
    "Processing queue" : {"localizations" : {"cs" : {"stringUnit" : {"state" : "translated", "value" : "Fronta zpracování"}}, "sk" : {"stringUnit" : {"state" : "translated", "value" : "Front spracovania"}}}},
    "Queued" : {"localizations" : {"cs" : {"stringUnit" : {"state" : "translated", "value" : "Ve frontě"}}, "sk" : {"stringUnit" : {"state" : "translated", "value" : "Vo fronte"}}}},
    "Resume processing" : {"localizations" : {"cs" : {"stringUnit" : {"state" : "translated", "value" : "Obnovit zpracování"}}, "sk" : {"stringUnit" : {"state" : "translated", "value" : "Obnoviť spracovanie"}}}},
    "Retry" : {"localizations" : {"cs" : {"stringUnit" : {"state" : "translated", "value" : "Zkusit znovu"}}, "sk" : {"stringUnit" : {"state" : "translated", "value" : "Skúsiť znova"}}}},
    "Retry saving recording" : {"localizations" : {"cs" : {"stringUnit" : {"state" : "translated", "value" : "Zkusit znovu uložit nahrávku"}}, "sk" : {"stringUnit" : {"state" : "translated", "value" : "Skúsiť znova uložiť nahrávku"}}}},
    "Show recordings" : {"localizations" : {"cs" : {"stringUnit" : {"state" : "translated", "value" : "Zobrazit nahrávky"}}, "sk" : {"stringUnit" : {"state" : "translated", "value" : "Zobraziť nahrávky"}}}},
    "Waiting for available resources" : {"localizations" : {"cs" : {"stringUnit" : {"state" : "translated", "value" : "Čeká na dostupné prostředky"}}, "sk" : {"stringUnit" : {"state" : "translated", "value" : "Čaká na dostupné prostriedky"}}}},
    "Unknown" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Neznámý" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Neznámy" } } } },
    "Prepare MeetingScribe" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Připravit MeetingScribe" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Pripraviť MeetingScribe" } } } },
    "You can leave any step and continue later." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Každý krok můžete opustit a později v něm pokračovat." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Každý krok môžete opustiť a neskôr v ňom pokračovať." } } } },
    "Later" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Později" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Neskôr" } } } },
    "Back" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zpět" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Späť" } } } },
    "Continue" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Pokračovat" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Pokračovať" } } } },
    "Finish without test" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Dokončit bez testu" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Dokončiť bez testu" } } } },
    "How MeetingScribe works" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Jak MeetingScribe funguje" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Ako MeetingScribe funguje" } } } },
    "MeetingScribe records system audio and your microphone locally, transcribes the audio on this Mac, and exports Markdown. A missing transcription model does not prevent recording." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe zaznamenává systémový zvuk a mikrofon lokálně, přepisuje zvuk na tomto Macu a exportuje Markdown. Chybějící přepisovací model nahrávání nebrání." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe nahráva systémový zvok a mikrofón lokálne, prepisuje zvuk na tomto Macu a exportuje Markdown. Chýbajúci prepisový model nahrávaniu nebráni." } } } },
    "AI analysis is optional. When it is enabled, the transcript and selected meeting metadata may be sent to the provider used by the selected CLI tool." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "AI analýza je volitelná. Když je zapnutá, přepis a vybraná metadata setkání mohou být odeslána poskytovateli vybraného CLI nástroje." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "AI analýza je voliteľná. Keď je zapnutá, prepis a vybrané metadáta stretnutia môžu byť odoslané poskytovateľovi vybraného CLI nástroja." } } } },
    "Transcription and output languages remain separate choices in Settings." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Jazyky přepisu a výstupu zůstanou samostatnými volbami v Nastavení." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Jazyky prepisu a výstupu zostanú samostatnými voľbami v Nastaveniach." } } } },
    "Sound and permissions" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zvuk a oprávnění" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zvuk a oprávnenia" } } } },
    "MeetingScribe records two separate tracks: system audio and your microphone. Permission is not proof that audio is arriving from a device." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe nahrává dvě samostatné stopy: systémový zvuk a mikrofon. Oprávnění není důkazem, že ze zařízení skutečně přichází zvuk." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "MeetingScribe nahráva dve samostatné stopy: systémový zvok a mikrofón. Oprávnenie nie je dôkazom, že zo zariadenia skutočne prichádza zvuk." } } } },
    "Needed to capture meeting sound from the system." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Potřebné k zachycení zvuku setkání ze systému." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Potrebné na zachytenie zvuku stretnutia zo systému." } } } },
    "Needed to capture your voice as a separate local track." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Potřebné k zachycení vašeho hlasu jako samostatné místní stopy." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Potrebné na zachytenie vášho hlasu ako samostatnej lokálnej stopy." } } } },
    "Allow system audio" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Povolit systémový zvuk" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Povoliť systémový zvok" } } } },
    "Allow microphone" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Povolit mikrofon" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Povoliť mikrofón" } } } },
    "After returning from System Settings, use Check again. If a newly granted permission is still not visible, restart MeetingScribe." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Po návratu ze systémových nastavení použijte Zkontrolovat znovu. Pokud nové oprávnění stále není vidět, restartujte MeetingScribe." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Po návrate zo systémových nastavení použite Skontrolovať znova. Ak nové oprávnenie stále nie je viditeľné, reštartujte MeetingScribe." } } } },
    "Transcription and storage" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Přepis a úložiště" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Prepis a úložisko" } } } },
    "Model status" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Stav modelu" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Stav modelu" } } } },
    "The model is downloaded, imported, or repaired only when you choose that action." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Model se stáhne, importuje nebo opraví jen po vaší výslovné akci." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Model sa stiahne, importuje alebo opraví až po vašej výslovnej akcii." } } } },
    "Choosing a folder verifies that the selected destination is writable; MeetingScribe creates only a temporary probe file." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Výběr složky ověří, že zvolený cíl je zapisovatelný; MeetingScribe vytvoří jen dočasný zkušební soubor." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Výber priečinka overí, že zvolený cieľ je zapisovateľný; MeetingScribe vytvorí len dočasný skúšobný súbor." } } } },
    "AI analysis is optional." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "AI analýza je volitelná." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "AI analýza je voliteľná." } } } },
    "Open AI settings" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Otevřít nastavení AI" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Otvoriť nastavenia AI" } } } },
