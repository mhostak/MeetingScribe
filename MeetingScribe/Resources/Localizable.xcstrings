    "GPT-5.6 Luna — fastest" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "GPT-5.6 Luna — nejrychlejší" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "GPT-5.6 Luna — najrýchlejší" } } } },
    "Claude Sonnet — recommended" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Claude Sonnet — doporučeno" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Claude Sonnet — odporúčané" } } } },
    "Claude Opus — highest quality" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Claude Opus — nejvyšší kvalita" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Claude Opus — najvyššia kvalita" } } } },
    "Custom model…" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Vlastní model…" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Vlastný model…" } } } },
    "Model identifier" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Identifikátor modelu" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Identifikátor modelu" } } } },
    "The selected tool chooses its configured or recommended model." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zvolený nástroj použije svůj nakonfigurovaný nebo doporučený model." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zvolený nástroj použije svoj nakonfigurovaný alebo odporúčaný model." } } } },
    "Balanced quality, speed, and cost for meeting analysis." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Vyvážený poměr kvality, rychlosti a nákladů pro analýzu setkání." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Vyvážený pomer kvality, rýchlosti a nákladov pre analýzu stretnutí." } } } },
    "Highest quality for complex or long meetings." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Nejvyšší kvalita pro složitá nebo dlouhá setkání." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Najvyššia kvalita pre zložité alebo dlhé stretnutia." } } } },
    "Fast and efficient for repeatable analysis." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Rychlý a efektivní model pro opakovanou analýzu." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Rýchly a efektívny model pre opakovanú analýzu." } } } },
    "Balanced quality and speed for meeting analysis." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Vyvážený poměr kvality a rychlosti pro analýzu setkání." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Vyvážený pomer kvality a rýchlosti pre analýzu stretnutí." } } } },
    "Enter a model identifier supported by the selected tool." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zadejte identifikátor modelu podporovaný zvoleným nástrojem." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zadajte identifikátor modelu podporovaný zvoleným nástrojom." } } } },
    "Enter a model identifier. Until then, the tool default will be used." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zadejte identifikátor modelu. Do té doby se použije výchozí model nástroje." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zadajte identifikátor modelu. Dovtedy sa použije predvolený model nástroja." } } } },
    "Meeting processed successfully" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Setkání bylo úspěšně zpracováno" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Stretnutie bolo úspešne spracované" } } } },
    "Meeting title (optional)" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Název setkání (volitelné)" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Názov stretnutia (voliteľné)" } } } },
    "Edit meeting title" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Upravit název setkání" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Upraviť názov stretnutia" } } } },
    "Minimum free storage" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Minimální volné místo" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Minimálne voľné miesto" } } } },
    "Missing" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Chybí" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Chýba" } } } },
    "Loading recordings…" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Načítání nahrávek…" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Načítavanie nahrávok…" } } } },
    "Model" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Model" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Model" } } } },
    "Model required" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Vyžadován model" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Vyžaduje sa model" } } } },
    "New meeting" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Nové setkání" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Nové stretnutie" } } } },
    "Next day" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Další den" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Nasledujúci deň" } } } },
    "No recordings for this day" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Pro tento den nejsou žádné nahrávky" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Pre tento deň nie sú žiadne nahrávky" } } } },
    "Not produced" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Nevytvořeno" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Nevytvorené" } } } },
    "Audio stays local. The transcript and selected meeting metadata may be sent to the provider used by the selected CLI tool." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zvuk zůstává místní. Přepis a vybraná metadata setkání mohou být odeslána poskytovateli, kterého používá zvolený CLI nástroj." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zvuk zostáva lokálne. Prepis a vybrané metadáta stretnutia môžu byť odoslané poskytovateľovi, ktorého používa zvolený CLI nástroj." } } } },
    "Open in Obsidian" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Otevřít v Obsidianu" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Otvoriť v Obsidiane" } } } },
