    "Automatic (tool default)" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Automaticky (výchozí nastavení nástroje)" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Automaticky (predvolené nastavenie nástroja)" } } } },
    "GPT-5.6 Terra — recommended" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "GPT-5.6 Terra — doporučeno" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "GPT-5.6 Terra — odporúčané" } } } },
