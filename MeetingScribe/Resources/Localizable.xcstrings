    "Show session in Finder" : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Zobrazit setkání ve Finderu" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zobraziť stretnutie vo Finderi" } } } },
    "Some session folders could not be read." : { "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Některé složky setkání nebylo možné načíst." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Niektoré priečinky stretnutí sa nepodarilo načítať." } } } },
